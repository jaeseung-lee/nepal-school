{
  "visa_d2_definition": {
    "value": "전문대학 이상의 교육기관 또는 학술연구기관에서 정규과정의 교육을 받거나 특정 연구를 하려는 사람",
    "source_url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290501&chrClsCd=010202&urlMode=lsInfoP&efYd=20261002&ancYnChk=0",
    "verified_by": "builder",
    "verified_on": "2026-10-31",
    "expires_on": "2027-10-31"
  },
  "visa_d4_definition": {
    "value": "법무부장관이 정하는 요건을 갖춘 교육기관이나 기업체, 단체 등에서 교육 또는 연수를 받거나 연구활동에 종사하려는 사람[연수기관으로부터 체재비를 초과하는 보수(報酬)를 받거나 유학(D-2)·기술연수(D-3) 체류자격에 해당하는 사람은 제외한다]",
    "source_url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290501&chrClsCd=010202&urlMode=lsInfoP&efYd=20261002&ancYnChk=0",
    "verified_by": "builder",
    "verified_on": "2026-10-31",
    "expires_on": "2027-10-31"
  },
  "part_time_work_permit_required": {
    "value": "유학(D-2) 유학생이 학업을 계속하면서 시간제 아르바이트를 하려면, 그 활동을 시작하기 전에 반드시 관할 출입국관리사무소에서 체류자격외활동허가를 받아야 한다.",
    "source_url": "https://www.hikorea.go.kr/info/InfoDatail.pt?CAT_SEQ=187&PARENT_ID=142",
    "verified_by": "builder",
    "verified_on": "2026-10-31",
    "expires_on": "2027-10-31"
  },
  "short_term_visa_cannot_work": {
    "value": "90일 이하 단기사증 소지자는 체류자격외활동을 할 수 없다. 시간제 아르바이트는 체류자격외활동허가를 받아야 하는 활동이므로, 단기사증으로는 아르바이트를 할 수 없다.",
    "source_url": "https://www.hikorea.go.kr/info/InfoDatail.pt?CAT_SEQ=187&PARENT_ID=142",
    "verified_by": "builder",
    "verified_on": "2026-10-31",
    "expires_on": "2027-10-31"
  },
